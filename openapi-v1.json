            "type": "array"
          },
          "nextPage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextpage"
          },
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          }
        },
        "required": [
          "schemaVersion",
          "fields",
          "items",
          "cursor",
          "hasMore",
          "nextPage"
        ],
        "title": "SelectedSnapshotResponse",
        "type": "object"
      },
      "SelectedUpsertChange": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "item": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PublicItem"
              },
              {
                "$ref": "#/components/schemas/PublicItemMinimal"
              }
            ],
            "title": "Item"
          },
          "op": {
            "const": "upsert",
            "title": "Op",
            "type": "string"
          }
        },
        "required": [
          "op",
          "id",
          "item"
        ],
        "title": "SelectedUpsertChange",
        "type": "object"
      },
      "StoryLink": {
        "properties": {
          "story": {
            "title": "Story",
            "type": "string"
          }
        },
        "required": [
          "story"
        ],
        "title": "StoryLink",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "AIHOT-aligned anonymous read-only API for curated AI news, hot topics, daily reports, durable selected-set sync, and low-traffic polling.",
    "title": "AI 信息小屋 · 公开分发 API v1",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/dailies": {
      "get": {
        "description": "List latest persisted report revision for each available date.",
        "operationId": "dailies_index_api_v1_dailies_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 7,
              "maximum": 30,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyIndexResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dailies Index"
      }
    },
    "/api/v1/dailies/latest": {
      "get": {
        "description": "Get the latest daily report.",
        "operationId": "latest_daily_api_v1_dailies_latest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyReportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "No daily report"
          }
        },
        "summary": "Latest Daily"
      }
    },
    "/api/v1/dailies/{date}": {
      "get": {
        "description": "Get daily report for a specific date (YYYY-MM-DD).",
        "operationId": "daily_by_date_api_v1_dailies__date__get",
        "parameters": [
          {
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyReportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Daily not found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Daily By Date"
      }
    },
    "/api/v1/fingerprint": {
      "get": {
        "description": "Lightweight data fingerprint for polling.",
        "operationId": "fingerprint_api_v1_fingerprint_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FingerprintResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          }
        },
        "summary": "Fingerprint"
      }
    },
    "/api/v1/hot-topics": {
      "get": {
        "description": "Get current hot topics from persisted distribution assessments.",
        "operationId": "hot_topics_api_v1_hot_topics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotTopicsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          }
        },
        "summary": "Hot Topics"
      }
    },
    "/api/v1/items": {
      "get": {
        "description": "List pre-assessed AI items from the persistent distribution store.",
        "operationId": "list_items_api_v1_items_get",
        "parameters": [
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "default": "selected",
              "pattern": "^(selected|all)$",
              "title": "Mode",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "default": "7d",
              "pattern": "^(24h|7d)$",
              "title": "Window",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(ai-models|ai-products|industry|paper|tip)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 2,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "by",
            "required": false,
            "schema": {
              "default": "timeline",
              "pattern": "^(timeline|published)$",
              "title": "By",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid cursor"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid query"
          }
        },
        "summary": "List Items"
      }
    },
    "/api/v1/selected/changes": {
      "get": {
        "description": "Return ordered idempotent upsert/remove changes after a watermark.",
        "operationId": "selected_changes_api_v1_selected_changes_get",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": true,
            "schema": {
              "maxLength": 512,
              "minLength": 1,
              "title": "Cursor",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectedChangesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Cursor expired; rebuild from snapshot"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid query"
          }
        },
        "summary": "Selected Changes"
      }
    },
    "/api/v1/selected/snapshot": {
      "get": {
        "description": "Return one page from a frozen complete selected-set snapshot.",
        "operationId": "selected_snapshot_api_v1_selected_snapshot_get",
        "parameters": [
          {
            "in": "query",
            "name": "fields",
            "required": false,
            "schema": {
              "default": "default",
              "pattern": "^(default|minimal)$",
              "title": "Fields",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectedSnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Snapshot page expired; restart the snapshot"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid query"
          }
        },
        "summary": "Selected Snapshot"
      }
    }
  }
}
