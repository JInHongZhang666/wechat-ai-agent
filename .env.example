# Copy this file to .env and fill in your own key. Never commit .env.
WECHAT_AGENT_LLM_API_KEY=replace-with-your-deepseek-api-key
WECHAT_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
WECHAT_AGENT_LLM_MODEL=deepseek-chat

# The built-in Agent is enabled by default. Set this to 0 only when needed.
WECHAT_AGENT_AGENT_ENABLED=1
