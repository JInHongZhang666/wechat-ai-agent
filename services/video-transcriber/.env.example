# Speaches is bound to localhost by compose.yaml. The main backend calls it
# through this OpenAI-compatible base URL.
WECHAT_AGENT_VIDEO_TRANSCRIBER_URL=http://127.0.0.1:8011/v1
WECHAT_AGENT_VIDEO_MODEL=Systran/faster-whisper-small
WECHAT_AGENT_VIDEO_MAX_FILE_MB=2048
WECHAT_AGENT_VIDEO_MAX_DURATION_MINUTES=180
